{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lama Desktop",
  "version": "0.3.1",
  "identifier": "com.battl.ollamadesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Lama Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Interface desktop pour Ollama",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERUQ1N0Q0MTA4NUZGRjYKUldUMi80VVExRmZ0N1hzVldGZFlTZm1neEdzUVNMSHRrMGErZkEzY0lJRU04OUJkdHNqQjhXRWwK",
      "endpoints": [
        "https://github.com/BattleLicorneUE/Lama-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}